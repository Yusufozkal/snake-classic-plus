ADMIN_EMAIL=site-owner@example.com
# Enable only behind Sites or another proxy that replaces incoming identity headers.
TRUST_PLATFORM_IDENTITY=0
# Leave empty unless this single-IP header is replaced by your trusted proxy.
TRUSTED_IP_HEADER=
# Per-minute size (1-100000, default 120) of the single bucket shared by guests without a network address.
# It has no daily cap; tune it from the traffic summary on the admin screen.
SHARED_START_LIMIT_PER_MINUTE=120
