ADMIN_EMAIL=site-owner@example.com
# Set to 1 only where the hosting platform itself writes the oai-authenticated-* headers and
# removes any copy sent by a visitor (OpenAI Sites). It does not authenticate anyone by itself.
TRUST_PLATFORM_IDENTITY=
# Starts per minute shared by guests whose network address is unavailable (default 120).
SHARED_START_LIMIT_PER_MINUTE=
